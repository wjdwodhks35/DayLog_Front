<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobileteamproject">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileTeamProject">

    <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".UploadActivity" android:exported="false"/>
        <activity android:name=".SearchActivity" android:exported="false"/>
        <activity android:name=".MapActivity" android:exported="false"/>
        <activity android:name=".MapNameActivity" android:exported="false"/>
        <activity android:name=".MyPageActivity" android:exported="false"/>
        <activity android:name=".MyUploadActivity" android:exported="false"/>
        <activity android:name=".CalendarActivity" android:exported="false"/>

    </application>
</manifest>
